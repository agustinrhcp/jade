module MaybeExamples exposing (find_first, pipeline, safe_divide)

def safe_divide(a: Int, b: Int) -> Maybe(Int)
  Maybe.map(non_zero(b), (d) -> { a / d })
end


def find_first(list: List(Int), predicate: Int -> Bool) -> Maybe(Int)
  List.filter(list, predicate) |> List.head
end


def pipeline(value: Int) -> Maybe(Int)
  safe_divide(100, value)
    |> Maybe.map((result) -> { result + 1 })
    |> Maybe.and_then((n) -> { safe_divide(n, 2) })
end
